{
  "//": "Config for the wasmTune demo's tuned tier (examples/lumen-docs -> warsang/lumen-assistant-qwen2.5-0.5b). Committed so the demo model is reproducible. siteName must match what the demo page passes to mountAssistant(), because it becomes the system prompt the model is trained against.",
  "dataDir": "./examples/lumen-docs",
  "models": [
    { "model": "Qwen/Qwen2.5-0.5B-Instruct", "label": "Lumen-tuned Qwen2.5 0.5B (ONNX, 51-pair smoke test)", "trained": true },
    { "model": "HuggingFaceTB/SmolLM2-360M-Instruct", "label": "SmolLM2 360M Instruct", "trained": false, "webllm": "SmolLM2-360M-Instruct-q4f16_1-MLC", "chat": { "maxTokens": 224, "temperature": 0.3 } },
    { "model": "Qwen/Qwen3-0.6B", "label": "Qwen3 0.6B", "trained": false, "webllm": "Qwen3-0.6B-q4f16_1-MLC", "chat": { "maxTokens": 256, "temperature": 0.3, "templateKwargs": { "enable_thinking": false } } },
    { "model": "meta-llama/Llama-3.2-1B-Instruct", "label": "Llama 3.2 1B Instruct", "trained": false, "webllm": "Llama-3.2-1B-Instruct-q4f16_1-MLC", "chat": { "maxTokens": 256, "temperature": 0.3 } },
    { "model": "Qwen/Qwen2.5-1.5B-Instruct", "label": "Qwen2.5 1.5B Instruct", "trained": false, "webllm": "Qwen2.5-1.5B-Instruct-q4f16_1-MLC", "chat": { "maxTokens": 256, "temperature": 0.3 } },
    { "model": "Qwen/Qwen3-1.7B", "label": "Qwen3 1.7B", "trained": false, "webllm": "Qwen3-1.7B-q4f16_1-MLC", "chat": { "maxTokens": 256, "temperature": 0.3, "templateKwargs": { "enable_thinking": false } } }
  ],
  "model": "Qwen/Qwen2.5-0.5B-Instruct",
  "method": "sft",
  "dataset": {
    "siteName": "Lumen"
  },
  "training": {
    "backend": "unsloth",
    "lora": { "r": 16, "alpha": 16, "dropout": 0.05, "targetModules": "auto" },
    "quantization": "q4",
    "epochs": 3,
    "batchSize": 2,
    "gradAccum": 4,
    "lr": 0.0002,
    "maxSeqLen": 2048,
    "numLayers": 16,
    "gradCheckpoint": false,
    "seed": 42,
    "maxSteps": 0
  },
  "chat": {
    "temperature": 0.2,
    "repetitionPenalty": 1.25,
    "maxTokens": 96,
    "topP": 0.9,
    "presencePenalty": 0.3,
    "frequencyPenalty": 0.5
  },
  "output": { "dir": "./.finetune", "webDir": "./demo/public/models" }
}
